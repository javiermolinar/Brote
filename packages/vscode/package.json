{
  "name": "brote",
  "displayName": "Brote",
  "description": "Your LLM debugger companion. Ask about live debugger state, right beside your code.",
  "version": "0.5.0",
  "publisher": "brote-local",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "brote.ask",
        "title": "Ask Brote About Selection"
      },
      {
        "command": "brote.nativeAnswer",
        "title": "Retry inline answer"
      },
      {
        "command": "brote.nativeResolve",
        "title": "Resolve Discussion"
      },
      {
        "command": "brote.nativeSend",
        "title": "Ask"
      },
      {
        "command": "brote.nativeDiscard",
        "title": "Discard question",
        "icon": "$(close)"
      },
      {
        "command": "brote.nativeCancel",
        "title": "Stop generating",
        "icon": "$(debug-stop)"
      },
      {
        "command": "brote.nativeChat",
        "title": "Continue in Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "brote.addTracepoint",
        "title": "Brote: Add Tracepoint",
        "icon": "$(add)"
      },
      {
        "command": "brote.editTracepoint",
        "title": "Edit Tracepoint",
        "icon": "$(edit)"
      },
      {
        "command": "brote.toggleTracepoint",
        "title": "Enable / Disable Tracepoint",
        "icon": "$(debug-breakpoint)"
      },
      {
        "command": "brote.removeTracepoint",
        "title": "Remove Tracepoint",
        "icon": "$(trash)"
      },
      {
        "command": "brote.attachSession",
        "title": "Brote: Attach to Session"
      },
      {
        "command": "brote.traces",
        "title": "Brote: Session Traces"
      }
    ],
    "chatParticipants": [
      {
        "id": "brote.chat",
        "name": "brote",
        "fullName": "Brote",
        "description": "Discuss captured native debugger state.",
        "isSticky": true,
        "commands": [
          {
            "name": "discuss",
            "description": "Continue a saved inline debugger discussion"
          }
        ]
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "brote.ask",
          "when": "isWorkspaceTrusted && resourceScheme == file",
          "group": "navigation"
        },
        {
          "command": "brote.addTracepoint",
          "when": "isWorkspaceTrusted && resourceLangId == go && resourceScheme == file",
          "group": "navigation"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "brote.nativeSend",
          "when": "commentController == brote.native && (commentThread == brote.nativeDraft || commentThread == brote.native)",
          "group": "inline"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "brote.nativeAnswer",
          "when": "commentController == brote.native && commentThread == brote.native",
          "group": "navigation"
        },
        {
          "command": "brote.nativeResolve",
          "when": "commentController == brote.native && commentThread == brote.native",
          "group": "navigation"
        },
        {
          "command": "brote.nativeDiscard",
          "when": "commentController == brote.native && commentThread == brote.nativeDraft",
          "group": "navigation"
        },
        {
          "command": "brote.nativeCancel",
          "when": "commentController == brote.native && commentThread == brote.nativeBusy",
          "group": "navigation"
        },
        {
          "command": "brote.nativeChat",
          "when": "commentController == brote.native && commentThread != brote.nativeDraft",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "brote.editTracepoint",
          "when": "view == brote.tracepoints && viewItem == brote.tracepoint",
          "group": "inline"
        },
        {
          "command": "brote.toggleTracepoint",
          "when": "view == brote.tracepoints && viewItem == brote.tracepoint",
          "group": "inline"
        },
        {
          "command": "brote.removeTracepoint",
          "when": "view == brote.tracepoints && viewItem == brote.tracepoint",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "editor.action.submitComment",
        "key": "enter",
        "when": "commentEditorFocused && commentController == brote.native && (commentThread == brote.nativeDraft || commentThread == brote.native) && !commentIsEmpty && !suggestWidgetVisible"
      }
    ],
    "languageModelTools": [
      {
        "name": "brote_inspect",
        "displayName": "Brote: Inspect paused program",
        "toolReferenceName": "brote",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Read the selected paused Brote service stack and bounded local variables. Does not execute the program.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "brote_tracepoints",
        "displayName": "Brote: Manage Go tracepoints",
        "toolReferenceName": "broteTracepoints",
        "canBeReferencedInPrompt": true,
        "modelDescription": "List, add, update or remove shared Go source tracepoints. Use when the user requests configuring runtime captures. Exclusive verified hits capture and automatically continue; ordinary or uncertain stops remain paused. Limits apply per run and values maps aliases to read-only Go expressions. Does not launch or start execution.",
        "inputSchema": {
          "type": "object",
          "required": [
            "action"
          ],
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "list",
                "add",
                "update",
                "remove"
              ]
            },
            "id": {
              "type": "string"
            },
            "file": {
              "type": "string",
              "description": "Absolute Go source path inside the workspace, required for add."
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "condition": {
              "type": "string"
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "hitLimit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "Brote",
      "properties": {
        "brote.runtimePath": {
          "type": "string",
          "description": "Absolute path to a Brote CLI. Defaults to the packaged runtime."
        }
      }
    },
    "views": {
      "debug": [
        {
          "id": "brote.tracepoints",
          "name": "Brote Tracepoints"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "brote.tracepoints",
        "contents": "Capture Go program state through the shared Brote service.\\n[Attach to Session](command:brote.attachSession)\\n[Add Tracepoint](command:brote.addTracepoint)"
      }
    ],
    "debuggers": [
      {
        "type": "brote",
        "label": "Brote Go Debugger",
        "languages": [
          "go"
        ],
        "configurationAttributes": {
          "attach": {
            "required": [],
            "properties": {
              "sessionId": {
                "type": "string",
                "description": "Existing Brote session ID. Omit to choose a session."
              }
            }
          },
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "debug",
                  "test",
                  "exec"
                ],
                "default": "debug"
              },
              "program": {
                "type": "string",
                "description": "Go package/source path, or executable for exec mode."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "envFile": {
                "type": "string"
              },
              "buildFlags": {
                "type": [
                  "string",
                  "array"
                ]
              },
              "dlvToolPath": {
                "type": "string"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "console": {
                "enum": [
                  "internalConsole"
                ]
              },
              "substitutePath": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "from",
                    "to"
                  ],
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    }
                  }
                }
              },
              "tracepoints": {
                "type": "array",
                "maxItems": 64,
                "description": "Source tracepoints installed before initial execution.",
                "items": {
                  "type": "object",
                  "required": [
                    "file",
                    "line"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "name": {
                      "type": "string"
                    },
                    "values": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "condition": {
                      "type": "string"
                    },
                    "hitCondition": {
                      "type": "string"
                    },
                    "captureLimit": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000
                    }
                  }
                }
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "brote",
            "request": "launch",
            "name": "Brote: Go program",
            "mode": "debug",
            "program": "${workspaceFolder}"
          },
          {
            "type": "brote",
            "request": "attach",
            "name": "Attach to Brote"
          }
        ]
      }
    ]
  },
  "license": "MIT",
  "extensionKind": [
    "workspace"
  ],
  "keywords": [
    "debugger",
    "agents",
    "Go",
    "Delve"
  ],
  "icon": "assets/brote-plant.png",
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/otlp-exporter-base": "0.222.0",
    "@opentelemetry/otlp-transformer": "0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  }
}
