{
  "name": "debug-handover",
  "displayName": "AgentDebugger",
  "description": "Collaborative debugging with humans and agents",
  "version": "0.3.0",
  "publisher": "debug-handover-local",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onDebug:debug-handover"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "debugHandover.attach",
        "title": "AgentDebugger: Attach Session"
      },
      {
        "command": "debugHandover.inspector",
        "title": "AgentDebugger: Open Live Inspector"
      },
      {
        "command": "debugHandover.ask",
        "title": "Ask AgentDebugger About Selection"
      },
      {
        "command": "debugHandover.answer",
        "title": "Answer in VS Code Chat"
      },
      {
        "command": "debugHandover.reply",
        "title": "Ask Follow-up"
      },
      {
        "command": "debugHandover.resolve",
        "title": "Resolve Discussion"
      },
      {
        "command": "debugHandover.nativeAnswer",
        "title": "Retry inline answer"
      },
      {
        "command": "debugHandover.nativeResolve",
        "title": "Resolve Discussion"
      },
      {
        "command": "debugHandover.nativeSend",
        "title": "Ask"
      },
      {
        "command": "debugHandover.nativeDiscard",
        "title": "Discard question",
        "icon": "$(close)"
      },
      {
        "command": "debugHandover.nativeCancel",
        "title": "Stop generating",
        "icon": "$(debug-stop)"
      },
      {
        "command": "debugHandover.nativeChat",
        "title": "Continue in Chat",
        "icon": "$(comment-discussion)"
      }
    ],
    "debuggers": [
      {
        "type": "debug-handover",
        "label": "AgentDebugger (Go / Delve)",
        "languages": [
          "go"
        ],
        "configurationAttributes": {
          "attach": {
            "required": [
              "handoverSession"
            ],
            "properties": {
              "handoverSession": {
                "type": "string",
                "description": "Existing AgentDebugger session ID"
              }
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "AgentDebugger",
      "properties": {
        "debugHandover.sessionDirectory": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Override the local session directory (for DEBUG_HANDOVER_HOME). Empty uses the OS cache directory."
        },
        "debugHandover.executable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the AgentDebugger CLI. Defaults to ~/.local/bin/agentdebugger."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "agentdebugger.chat",
        "name": "agentdebugger",
        "fullName": "AgentDebugger",
        "description": "Debug precompiled programs and discuss captured debugger evidence.",
        "isSticky": true,
        "commands": [
          {
            "name": "answer",
            "description": "Answer a persisted debugger question: SESSION_ID THREAD_ID"
          },
          {
            "name": "discuss",
            "description": "Continue a saved inline debugger discussion in Chat"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "agentdebugger_debug",
        "displayName": "AgentDebugger",
        "toolReferenceName": "agentdebugger",
        "canBeReferencedInPrompt": true,
        "modelDescription": "List workspace sessions, launch an existing precompiled Go binary, attach the native debugger, inspect stack/locals, evaluate read-only expressions, set conditional breakpoints, or execute one authorized step/continue. Never compile implicitly. Only execute when explicitly requested; questions about values are read-only. Execution waits up to 30 seconds then pauses.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "enum": [
                "sessions",
                "launch",
                "attach",
                "inspect",
                "breakpoint",
                "continue",
                "next",
                "step",
                "stepout",
                "evaluate"
              ]
            },
            "session": {
              "type": "string"
            },
            "binary": {
              "type": "string"
            },
            "project": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "condition": {
              "type": "string"
            },
            "expression": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "goroutine": {
              "type": "integer",
              "minimum": 1
            },
            "frame": {
              "type": "integer",
              "minimum": 0
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "operation"
          ]
        }
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "debugHandover.ask",
          "when": "isWorkspaceTrusted && resourceScheme == file",
          "group": "navigation"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "debugHandover.reply",
          "when": "commentController == agentdebugger",
          "group": "inline"
        },
        {
          "command": "debugHandover.nativeSend",
          "when": "commentController == agentdebugger.native && (commentThread == agentdebugger.nativeDraft || commentThread == agentdebugger.native)",
          "group": "inline"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "debugHandover.resolve",
          "when": "commentController == agentdebugger && commentThread == agentdebugger.thread",
          "group": "navigation"
        },
        {
          "command": "debugHandover.answer",
          "when": "commentController == agentdebugger",
          "group": "navigation"
        },
        {
          "command": "debugHandover.nativeAnswer",
          "when": "commentController == agentdebugger.native && commentThread == agentdebugger.native",
          "group": "navigation"
        },
        {
          "command": "debugHandover.nativeResolve",
          "when": "commentController == agentdebugger.native && commentThread == agentdebugger.native",
          "group": "navigation"
        },
        {
          "command": "debugHandover.nativeDiscard",
          "when": "commentController == agentdebugger.native && commentThread == agentdebugger.nativeDraft",
          "group": "navigation"
        },
        {
          "command": "debugHandover.nativeCancel",
          "when": "commentController == agentdebugger.native && commentThread == agentdebugger.nativeBusy",
          "group": "navigation"
        },
        {
          "command": "debugHandover.nativeChat",
          "when": "commentController == agentdebugger.native && commentThread != agentdebugger.nativeDraft",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "editor.action.submitComment",
        "key": "enter",
        "when": "commentEditorFocused && commentController == agentdebugger.native && (commentThread == agentdebugger.nativeDraft || commentThread == agentdebugger.native) && !commentIsEmpty && !suggestWidgetVisible"
      }
    ]
  }
}
