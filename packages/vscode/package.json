{
  "name": "debug-handover",
  "displayName": "AgentDebugger",
  "description": "Collaborative debugging with humans and agents",
  "version": "0.3.0",
  "publisher": "debug-handover-local",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onDebug:debug-handover"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "debugHandover.reclaim",
        "title": "AgentDebugger: Give Control to Agent"
      },
      {
        "command": "debugHandover.attach",
        "title": "AgentDebugger: Attach Pending Session"
      },
      {
        "command": "debugHandover.inspector",
        "title": "AgentDebugger: Open Live Inspector"
      }
    ],
    "debuggers": [
      {
        "type": "debug-handover",
        "label": "AgentDebugger (Go / Delve)",
        "languages": [
          "go"
        ],
        "configurationAttributes": {
          "attach": {
            "required": [
              "handoverSession"
            ],
            "properties": {
              "handoverSession": {
                "type": "string",
                "description": "Existing AgentDebugger session ID"
              }
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "AgentDebugger",
      "properties": {
        "debugHandover.sessionDirectory": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Override the local session directory (for DEBUG_HANDOVER_HOME). Empty uses the OS cache directory."
        }
      }
    }
  }
}
