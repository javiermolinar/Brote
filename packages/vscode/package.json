{
  "name": "brote",
  "displayName": "Brote",
  "description": "Your LLM debugger companion. Ask about live debugger state, right beside your code.",
  "version": "0.5.0",
  "publisher": "brote-local",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "brote.ask",
        "title": "Ask Brote About Selection"
      },
      {
        "command": "brote.nativeAnswer",
        "title": "Retry inline answer"
      },
      {
        "command": "brote.nativeResolve",
        "title": "Resolve Discussion"
      },
      {
        "command": "brote.nativeSend",
        "title": "Ask"
      },
      {
        "command": "brote.nativeDiscard",
        "title": "Discard question",
        "icon": "$(close)"
      },
      {
        "command": "brote.nativeCancel",
        "title": "Stop generating",
        "icon": "$(debug-stop)"
      },
      {
        "command": "brote.nativeChat",
        "title": "Continue in Chat",
        "icon": "$(comment-discussion)"
      }
    ],
    "chatParticipants": [
      {
        "id": "brote.chat",
        "name": "brote",
        "fullName": "Brote",
        "description": "Discuss captured native debugger state.",
        "isSticky": true,
        "commands": [
          {
            "name": "discuss",
            "description": "Continue a saved inline debugger discussion"
          }
        ]
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "brote.ask",
          "when": "isWorkspaceTrusted && resourceScheme == file",
          "group": "navigation"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "brote.nativeSend",
          "when": "commentController == brote.native && (commentThread == brote.nativeDraft || commentThread == brote.native)",
          "group": "inline"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "brote.nativeAnswer",
          "when": "commentController == brote.native && commentThread == brote.native",
          "group": "navigation"
        },
        {
          "command": "brote.nativeResolve",
          "when": "commentController == brote.native && commentThread == brote.native",
          "group": "navigation"
        },
        {
          "command": "brote.nativeDiscard",
          "when": "commentController == brote.native && commentThread == brote.nativeDraft",
          "group": "navigation"
        },
        {
          "command": "brote.nativeCancel",
          "when": "commentController == brote.native && commentThread == brote.nativeBusy",
          "group": "navigation"
        },
        {
          "command": "brote.nativeChat",
          "when": "commentController == brote.native && commentThread != brote.nativeDraft",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "editor.action.submitComment",
        "key": "enter",
        "when": "commentEditorFocused && commentController == brote.native && (commentThread == brote.nativeDraft || commentThread == brote.native) && !commentIsEmpty && !suggestWidgetVisible"
      }
    ],
    "languageModelTools": [
      {
        "name": "brote_inspect",
        "displayName": "Brote: Inspect paused program",
        "toolReferenceName": "brote",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Read the selected paused native debug session stack and bounded local variables. Does not execute the program.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      }
    ],
    "configuration": {
      "title": "Brote",
      "properties": {
        "brote.capturePoints": {
          "type": "object",
          "default": {},
          "description": "Map exact DAP function names to stable capture names and named local selections for trace comparison. Does not add breakpoints or evaluate expressions.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 128
              },
              "values": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "license": "MIT",
  "extensionKind": [
    "workspace"
  ],
  "keywords": [
    "debugger",
    "agents",
    "Go",
    "Delve"
  ],
  "icon": "assets/brote-plant.png",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  }
}
