{
  "name": "debug-handover-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test ui/inspector/preview-ui.test.mjs editors/vscode/test/*.test.cjs",
    "check": "tsc -p ui/inspector/tsconfig.json && tsc -p editors/vscode/tsconfig.json",
    "build": "npm run check && npm run build:inspector && npm run build:vscode",
    "build:inspector": "esbuild ui/inspector/src/app.ts --bundle --minify --target=es2022 --outfile=ui/inspector/public/app.js --legal-comments=eof",
    "build:vscode": "esbuild editors/vscode/src/extension.ts --bundle --platform=node --format=cjs --external:vscode --target=node20 --outfile=editors/vscode/dist/extension.js && esbuild editors/vscode/src/protocol.ts --bundle --platform=node --format=cjs --target=node20 --outfile=editors/vscode/dist/protocol.cjs",
    "preview": "node ui/inspector/preview-ui.mjs",
    "package:vscode": "cd editors/vscode && npm exec --yes --package=@vscode/vsce@4.0.0 -- vsce package --no-dependencies --allow-missing-repository --skip-license --out debug-handover-0.1.0.vsix"
  },
  "dependencies": {
    "highlight.js": "11.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "^1.138.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
