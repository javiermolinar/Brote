{
  "name": "brote",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Brote \u2014 your LLM debugger companion",
  "keywords": [
    "pi-package",
    "debugger",
    "brote"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/javiermolinar/Brote.git"
  },
  "pi": {
    "extensions": [
      "./adapters/pi/git.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "postinstall": "node scripts/install-pi-runtime.mjs --if-production",
    "setup:pi": "node scripts/install-pi-runtime.mjs",
    "test": "node --test packages/web/*.test.mjs packages/vscode/test/*.test.cjs adapters/pi/*.test.mjs packages/client/test/*.test.cjs scripts/*.test.mjs",
    "check": "tsc -p packages/web/tsconfig.json && tsc -p packages/vscode/tsconfig.json && tsc -p adapters/pi/tsconfig.json",
    "build": "npm run build:assets && npm run check && npm run build:inspector && npm run build:vscode",
    "build:inspector": "esbuild packages/web/src/app.ts --bundle --minify --target=es2022 --outfile=packages/web/public/app.js --legal-comments=eof",
    "build:vscode": "esbuild packages/vscode/src/extension.ts --bundle --minify --supported:template-literal=false --legal-comments=eof --platform=node --format=cjs --external:vscode --target=node20 --outfile=packages/vscode/dist/extension.js",
    "preview": "node packages/web/preview-ui.mjs",
    "package:vscode": "python3 scripts/release.py --host-only --output dist/releases",
    "package:release": "python3 scripts/release.py",
    "test:packaging": "python3 -m unittest discover -s scripts -p \"test_*.py\"",
    "build:assets": "node scripts/brand-assets.mjs"
  },
  "dependencies": {
    "highlight.js": "11.12.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.20.4",
    "@types/vscode": "^1.138.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.0",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
