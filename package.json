{
  "name": "agentdebugger",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test packages/web/*.test.mjs packages/vscode/test/*.test.cjs adapters/pi/*.test.mjs packages/client/test/*.test.cjs",
    "check": "tsc -p packages/web/tsconfig.json && tsc -p packages/vscode/tsconfig.json && tsc -p adapters/pi/tsconfig.json",
    "build": "npm run check && npm run build:inspector && npm run build:vscode",
    "build:inspector": "esbuild packages/web/src/app.ts --bundle --minify --target=es2022 --outfile=packages/web/public/app.js --legal-comments=eof",
    "build:vscode": "esbuild packages/vscode/src/extension.ts --bundle --platform=node --format=cjs --external:vscode --target=node20 --outfile=packages/vscode/dist/extension.js && esbuild packages/vscode/src/protocol.ts --bundle --platform=node --format=cjs --target=node20 --outfile=packages/vscode/dist/protocol.cjs",
    "preview": "node packages/web/preview-ui.mjs",
    "package:vscode": "cd packages/vscode && npm exec --yes --package=@vscode/vsce@4.0.0 -- vsce package --no-dependencies --allow-missing-repository --skip-license --out debug-handover-0.1.0.vsix"
  },
  "dependencies": {
    "highlight.js": "11.12.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.20.4",
    "@types/vscode": "^1.138.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.0",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
