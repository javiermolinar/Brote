#!/bin/sh
set -eu
plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "$(uname -s)/$(uname -m)" in
  Darwin/arm64) target=darwin-arm64;;
  Darwin/x86_64) target=darwin-x64;;
  Linux/aarch64|Linux/arm64) target=linux-arm64;;
  Linux/x86_64|Linux/amd64) target=linux-x64;;
  *) target=unsupported;;
esac
native="$plugin_root/adapters/pi/runtime/$target/brote"
if [ -x "$native" ]; then exec "$native" "$@"; fi
cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/debug-handover"
mkdir -p "$cache_root"
# Cache by source content, avoiding rebuilds of both the helper and target.
source_hash=$(
  cd "$plugin_root"
  {
    cat go.mod
    find cmd internal packages/web -type f \( -name '*.go' -o -path 'packages/web/public/*' \) |
      LC_ALL=C sort |
      while IFS= read -r source_file; do
        printf '%s\n' "$source_file"
        cat "$source_file"
      done
  } | shasum -a 256 | cut -d ' ' -f 1
)
helper="$cache_root/debug-handover-$source_hash"
if [ ! -x "$helper" ]; then
  temp="$helper.$$"
  trap 'rm -f "$temp"' EXIT INT TERM
  (cd "$plugin_root" && go build -buildvcs=false -o "$temp" ./cmd/debug-handover)
  mv "$temp" "$helper"
  trap - EXIT INT TERM
fi
exec "$helper" "$@"
